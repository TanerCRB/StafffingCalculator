#!/usr/bin/env sh
# StafffingCalculator's "don't push directly to main" hook.
# Installed via: git config core.hooksPath .githooks
# Check: `git config --get core.hooksPath`.
#
# This is NOT branch protection — GitHub doesn't give you that on a private repository on the
# free plan. This file is bypassed with a single `--no-verify` and doesn't work for anyone who
# hasn't installed it. And that's the point: whoever types `--no-verify` knows what they're
# doing. Whoever forgot which branch they're on doesn't — and that's the case this hook catches.

# The refusal comes before the tests: a push to main must be stopped even when tests pass.

protected_ref="refs/heads/main"
blocked=0

# git supplies one line per reference: <local> <sha> <remote> <sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "$protected_ref" ]; then
        blocked=1
    fi
done

if [ "$blocked" -eq 1 ]; then
    echo "" >&2
    echo "  REFUSED: direct push to main." >&2
    echo "" >&2
    echo "  Changes go through a pull request - that is gate 2 of the process." >&2
    echo "  Create a branch and open a PR:" >&2
    echo "" >&2
    echo "      git checkout -b <branch-name>" >&2
    echo "      git push -u origin <branch-name>" >&2
    echo "      gh pr create --fill" >&2
    echo "" >&2
    echo "  The hook can be bypassed with 'git push --no-verify' - deliberately, not by accident." >&2
    echo "" >&2
    exit 1
fi

# The documentation validator, if one exists, runs BEFORE the stack-specific tests, because it's
# cheap (a fraction of a second) and applies repository-wide.
if [ -f tools/validate-docs.mjs ]; then
    if ! command -v node >/dev/null 2>&1; then
        echo "" >&2
        echo "  pre-push: node is missing, and this repository has a documentation validator." >&2
        echo "  Install Node or run the push with --no-verify deliberately." >&2
        echo "" >&2
        exit 1
    fi

    if ! node tools/validate-docs.mjs; then
        echo "" >&2
        echo "  REFUSED: the documentation validator reported an error." >&2
        echo "" >&2
        exit 1
    fi
fi

# Backend tests: run wherever backend/ has a pytest-runnable project. Condition is on the
# presence of the project marker, not a hardcoded assumption that backend/ always exists.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "  pre-push: cannot find the working tree root; run this hook from a Git checkout." >&2
    exit 1
}
git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || {
    echo "  pre-push: cannot find the shared Git directory; run this hook from a Git checkout." >&2
    exit 1
}
case "$git_common_dir" in
    /*) ;;
    *) git_common_dir=$(cd "$repo_root" && cd "$git_common_dir" && pwd -P) || exit 1 ;;
esac
main_checkout=$(dirname "$git_common_dir")

if [ -f "$repo_root/backend/pyproject.toml" ] || [ -f "$repo_root/backend/setup.cfg" ]; then
    pytest_command=$(command -v pytest 2>/dev/null || true)
    if [ -z "$pytest_command" ]; then
        for candidate in \
            "$repo_root/backend/.venv/Scripts/pytest.exe" \
            "$repo_root/backend/.venv/Scripts/pytest" \
            "$repo_root/backend/.venv/bin/pytest" \
            "$main_checkout/backend/.venv/Scripts/pytest.exe" \
            "$main_checkout/backend/.venv/Scripts/pytest" \
            "$main_checkout/backend/.venv/bin/pytest" \
            "$repo_root/.venv/Scripts/pytest.exe" \
            "$repo_root/.venv/Scripts/pytest" \
            "$repo_root/.venv/bin/pytest" \
            "$main_checkout/.venv/Scripts/pytest.exe" \
            "$main_checkout/.venv/Scripts/pytest" \
            "$main_checkout/.venv/bin/pytest"; do
            if [ -x "$candidate" ]; then pytest_command=$candidate; break; fi
        done
    fi
    if [ -z "$pytest_command" ]; then
        echo "  pre-push: backend/ has a Python project, but pytest was not found." >&2
        echo "  Run: cd \"$repo_root/backend\" && uv sync --extra dev && uv run pytest" >&2
        exit 1
    fi
    (cd "$repo_root/backend" && "$pytest_command") || exit 1
fi

# Frontend tests: run wherever frontend/ declares a `test` script.
if [ -f "$repo_root/frontend/package.json" ] && \
   (cd "$repo_root/frontend" && node -e 'process.exit(require("./package.json").scripts?.test ? 0 : 1)' 2>/dev/null); then

    # pnpm is sometimes off PATH despite Node being installed — the packageManager field doesn't
    # install anything, it only tells corepack which version to run.
    # COREPACK_ENABLE_DOWNLOAD_PROMPT=0, because a prompt asked inside a hook has no one to answer it.
    if ! command -v pnpm >/dev/null 2>&1; then
        if command -v corepack >/dev/null 2>&1; then
            pnpm() { (cd "$repo_root/frontend" && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm "$@"); }
        else
            echo "" >&2
            echo "  pre-push: pnpm and corepack are both missing. Install Node 22+ or add pnpm to PATH." >&2
            echo "" >&2
            exit 1
        fi
    else
        pnpm() { (cd "$repo_root/frontend" && command pnpm "$@"); }
    fi

    if [ ! -d "$repo_root/frontend/node_modules" ]; then
        echo "  pre-push: frontend dependencies are missing." >&2
        echo "  Run: cd \"$repo_root/frontend\" && pnpm install --frozen-lockfile" >&2
        exit 1
    fi

    # E2E is deliberately outside the hook: it requires a build and a browser, so it's a gate in CI.
    pnpm test || exit 1
fi

exit 0
