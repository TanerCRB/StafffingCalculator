APP_APP_NAME=StafffingCalculator
APP_ENVIRONMENT=development
# PostgreSQL only (ADR-0001). Never commit real credentials — this file is an example.
APP_DATABASE_URL=postgresql+psycopg://staffing:staffing@localhost:5432/staffing
# Placeholder caller identity header (ADR-0005, addendum 2026-09-18). Replaced by real
# authentication once its own ADR is accepted.
APP_CALLER_ID_HEADER=X-Caller-User-Id
# Running the placeholder identity must be opted into explicitly: without this line the
# application refuses to start (and refuses anyway unless APP_ENVIRONMENT is development or
# test). It belongs in a developer's local .env — never in a deployed environment.
APP_ALLOW_PLACEHOLDER_IDENTITY=true
